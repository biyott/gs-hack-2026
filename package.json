{
  "name": "gs-safety-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.4"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "biome check app src packages scripts *.json *.ts *.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "candidate:manifest": "tsx scripts/candidate-manifest.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/server/db/seed.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "js-aruco2": "2.0.0",
    "ky": "2.1.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "three": "0.186.0",
    "yaml": "2.9.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "drizzle-kit": "0.31.10",
    "playwright": "1.63.0",
    "react-doctor": "0.9.14",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
