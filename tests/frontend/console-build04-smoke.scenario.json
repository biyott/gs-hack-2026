{
  "buildType": "development",
  "settleImages": true,
  "expectedHttpErrors": [
    {
      "method": "GET",
      "path": "/api/session",
      "status": 401,
      "maxOccurrences": 2,
      "beforeMutation": true
    }
  ],
  "allowedMutations": [
    {
      "method": "POST",
      "path": "/api/session"
    }
  ],
  "expectedRequestFailures": [],
  "routes": [
    {
      "id": "console",
      "path": "/",
      "readySelector": ".entry-screen h1",
      "states": [
        {
          "id": "observer-connected",
          "actions": [
            {
              "kind": "select",
              "selector": "label:has-text('역할') select",
              "value": "observer"
            },
            {
              "kind": "fill",
              "selector": "input[type='password']",
              "valueEnv": "QA_DEMO_ACCESS_CODE",
              "value": "2026"
            },
            {
              "kind": "click",
              "selector": "button[type='submit']"
            },
            {
              "kind": "wait-visible",
              "selector": "[data-testid='mode-equipment']:not(:disabled)"
            },
            {
              "kind": "expect-text",
              "selector": ".entry-session",
              "value": "observer · observer"
            },
            {
              "kind": "scroll",
              "selector": ".entry-brand"
            }
          ]
        },
        {
          "id": "equipment-current-3d-overview",
          "actions": [
            {
              "kind": "click",
              "selector": "[data-testid='mode-equipment']"
            },
            {
              "kind": "wait-text",
              "selector": ".workspace-heading h1",
              "value": "중장비 접근 대응"
            },
            {
              "kind": "wait-text",
              "selector": "[data-testid='connection-state']",
              "value": "실시간 연결"
            },
            {
              "kind": "wait-visible",
              "selector": "[data-testid='site-canvas'] canvas"
            },
            {
              "kind": "wait-resource",
              "value": "/assets/site/hvo-demo.glb"
            },
            {
              "kind": "wait-all-hidden",
              "selector": ".scene-loading, .scene-failure"
            },
            {
              "kind": "expect-attribute",
              "selector": "[data-testid='scenario-select']",
              "name": "disabled",
              "value": ""
            },
            {
              "kind": "expect-attribute",
              "selector": "[data-testid='equipment-select']",
              "name": "disabled",
              "value": ""
            },
            {
              "kind": "expect-attribute",
              "selector": "[data-testid='run-toggle']",
              "name": "disabled",
              "value": ""
            },
            {
              "kind": "scroll",
              "selector": ".console-header"
            },
            {
              "kind": "expect-visible-unique",
              "selector": ".console-header .status-synthetic",
              "value": "시뮬레이션 / SIMULATION",
              "inViewport": true
            }
          ],
          "afterActionMs": 500
        }
      ]
    }
  ],
  "viewports": [
    {
      "width": 375,
      "height": 812
    },
    {
      "width": 1280,
      "height": 720
    }
  ]
}
