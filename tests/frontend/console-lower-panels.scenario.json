          "selector": "[data-testid='scenario-select'] option:checked",
          "name": "value",
          "value": "FG-FIRE",
          "eventPhase": "fire-gas-setup-complete"
        },
        {
          "kind": "expect-attribute",
          "selector": "[data-testid='scenario-select']",
          "name": "disabled",
