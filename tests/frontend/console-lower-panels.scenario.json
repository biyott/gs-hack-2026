        },
        {
          "kind": "expect-attribute",
          "selector": "[data-testid='run-toggle']",
          "name": "disabled",
          "value": ""
        },
        {
          "kind": "wait-visible",
          "selector": "[data-testid='site-canvas'] canvas"
        },
        {
          "kind": "wait-resource",
          "value": "/assets/site/hvo-demo.glb"
        },
        {
          "kind": "wait-all-hidden",
          "selector": ".scene-loading, .scene-failure"
        }
      ],
      "states": [
        {
          "id": "first-guidance-a",
          "actions": [
            {
              "kind": "click",
              "selector": "#incident-detail .incident-list-item:has(strong:text-is('화재')):has(.status-badge:text-is('진행 중'))"
            },
            {
              "kind": "wait-visible",
              "selector": "#incident-detail [aria-label='최초 안내 기록'] .guidance-record:has(.guidance-record-heading > strong:text-is('WORKER-A'))"
            },
            {
              "kind": "expect-text",
              "selector": "#incident-detail [aria-label='최초 안내 기록'] .guidance-record:has(.guidance-record-heading > strong:text-is('WORKER-A'))",
              "value": "최초 원문 · 기록 고정"
            }
          ],
          "focusTarget": "#incident-detail [aria-label='최초 안내 기록'] .guidance-record:has(.guidance-record-heading > strong:text-is('WORKER-A'))"
        },
        {
          "id": "current-guidance-delivery-a",
          "actions": [
            {
              "kind": "wait-visible",
              "selector": "#incident-detail [aria-label='현재 안내와 응답'] .incident-worker-guidance:has(.guidance-record-heading > strong:text-is('WORKER-A'))"
            },
            {
              "kind": "expect-text",
              "selector": "#incident-detail [aria-label='현재 안내와 응답'] .incident-worker-guidance:has(.guidance-record-heading > strong:text-is('WORKER-A')) .delivery-status",
              "value": "전달 · 응답 · 지원"
            },
            {
              "kind": "expect-text",
              "selector": "#incident-detail .incident-detail > p.muted:last-child",
              "value": "이 역할은 사건 기록을 조회할 수 있습니다."
            },
            {
              "kind": "wait-hidden",
              "selector": "#incident-detail .incident-actions"
            }
          ],
          "focusTarget": [
            "#incident-detail [aria-label='현재 안내와 응답'] .incident-worker-guidance:has(.guidance-record-heading > strong:text-is('WORKER-A'))",
            "#incident-detail .incident-detail > p.muted:last-child"
          ]
        },
        {
          "id": "worker-board",
          "actions": [
            {
              "kind": "wait-visible",
              "selector": ".worker-board .worker-card:has(.worker-card-heading strong:text-is('WORKER-A'))"
            },
            {
              "kind": "wait-visible",
              "selector": ".worker-board .worker-card:has(.worker-card-heading strong:text-is('WORKER-B'))"
            },
            {
              "kind": "wait-hidden",
              "selector": ".worker-board .worker-card:has(.worker-card-heading strong:text-is('WORKER-C'))"
            }
          ],
          "focusTarget": [
            ".worker-board .worker-card:has(.worker-card-heading strong:text-is('WORKER-A'))",
            ".worker-board .worker-card:has(.worker-card-heading strong:text-is('WORKER-B'))"
          ]
        }
      ]
    }
  ],
  "expectedRequestFailures": [
    {
      "method": "GET",
      "path": "/api/events",
      "query": {
        "mode": "equipment"
      },
      "error": "net::ERR_ABORTED",
      "state": "fire-gas-initial-mode-selection",
      "maxOccurrences": 1
    }
  ]
}
