# One Node application server, SQLite accessible only to server code.
DATABASE_PATH=data/runtime/safety.sqlite
# Replace for any shared LAN session; never commit a real access code.
GS_DEMO_PIN=replace-before-shared-demo

# Local inference provider; not a separate application/database server.
RAG_LLM_BASE_URL=http://127.0.0.1:8092/v1
RAG_LLM_MODEL=Qwen3-0.6B-Q8_0
RAG_LLM_VERSION=23749fefcc72300e3a2ad315e1317431b06b590a
RAG_TIMEOUT_MS=5000
RAG_EMBEDDING_MODEL=Xenova/multilingual-e5-small
RAG_EMBEDDING_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
RAG_EMBEDDING_DIMENSIONS=384
RAG_EMBEDDING_LOCAL_PATH=data/knowledge/runtime/models/Xenova/multilingual-e5-small
# RAG_LLM_API_KEY is optional for an explicitly configured remote provider.
# RAG_MODEL_CACHE=data/knowledge/runtime/cache

# Node ONNX package: avoid downloading optional CUDA assets for CPU inference.
ONNXRUNTIME_NODE_INSTALL_CUDA=skip
